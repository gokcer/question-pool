# Copy this file to .env and fill it in. Never commit .env.

# Database password (any long random text)
DB_PASSWORD=change-me

# Public address of the site, without a slash at the end. Login links in e-mails start with it.
APP_BASE_URL=https://pool.example.com
# true when the site is served over HTTPS (it should be)
SECURE_COOKIES=true
APP_PORT=8080

# This address becomes the instructor account on first start.
INSTRUCTOR_EMAIL=
INSTRUCTOR_NAME=Gökçer Gökdal

# SMTP account that sends the login links. With SMTP_HOST empty, links are only written to the app log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address, if it is different from SMTP_USER
MAIL_FROM=

# Outlook on the web (on-premises Exchange) whose SMTP ports are closed: put its EWS address here.
# Then mail goes through EWS with SMTP_USER and SMTP_PASSWORD, and SMTP_HOST/SMTP_PORT are not used.
EWS_URL=

# AI (OpenRouter). With an empty key the site works without the AI check, explanations and helper.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Rules
QUESTIONS_PER_CHAPTER=2
ASK_AI_PER_DAY=10
